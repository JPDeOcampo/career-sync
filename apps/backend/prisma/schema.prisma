generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum AppearanceType {
  COLOR
  IMAGE
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum DocumentType {
  CV
  COVER_LETTER
}

model User {
  id        String @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  email     String @unique

  accounts      Account[]
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)

  loginCount    Int @default(0)
  loginAttempts Int @default(0)

  lockoutUntil DateTime?
  lastLoginAt  DateTime?

  refreshTokens RefreshToken[]
  authTokens    AuthToken[]

  profile  UserProfile?
  settings UserSettings?

  jobs      Job[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model UserProfile {
  id String @id @default(uuid()) @db.Uuid

  displayName String?
  bio         String?

  profileType  AppearanceType @default(COLOR)
  profileValue String?

  coverType  AppearanceType @default(COLOR)
  coverValue String?

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSettings {
  id String @id @default(uuid()) @db.Uuid

  darkMode Boolean @default(false)

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id String @id @default(uuid())

  provider          AuthProvider
  providerAccountId String
  passwordHash      String?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([provider])
}

model AuthToken {
  id String @id @default(uuid())

  tokenHash String        @unique
  type      AuthTokenType

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([type])
  @@index([usedAt])
  @@index([revokedAt])
  @@index([type, expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Job {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  company        String
  roleTitle      String
  jobDescription String?

  jobType String?
  salary  String?

  workSetup    String?
  workSchedule String?

  location String?
  jobLink  String?

  applicationMethod String?
  applicationDate   DateTime?

  status   String?
  priority String?

  cvId          String? @db.Uuid
  coverLetterId String? @db.Uuid

  contact String?
  offer   Boolean @default(false)

  notes String?

  interviewStages InterviewStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cv          Document? @relation("JobCV", fields: [cvId], references: [id])
  coverLetter Document? @relation("JobCL", fields: [coverLetterId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id     String       @id @default(uuid()) @db.Uuid
  userId String       @db.Uuid
  type   DocumentType

  fileUrl  String
  filePath String
  name     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobsWithCV Job[] @relation("JobCV")
  jobsWithCL Job[] @relation("JobCL")
  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, type])
}

model InterviewStage {
  id    String @id @default(uuid()) @db.Uuid
  jobId String @db.Uuid

  interviewType String
  interviewDate DateTime?
  interviewTime String?

  interviewerName  String?
  interviewComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
